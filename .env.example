# ==============================================================================
# NOVAFLIX STREAMING v2.0 - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env na sua VPS ou ambiente local:
#   cp .env.example .env
# ==============================================================================

# Porta onde o servidor Node.js irá rodar (Padrão: 3000)
PORT=3000

# Chave secreta para assinatura dos tokens JWT do Painel ADM
ADMIN_JWT_SECRET=novaflix_jwt_secret_key_2026_super_safe_token

# URL da Lista IPTV M3U/M3U8 Principal (Opcional - pode ser configurada pelo Painel ADM)
PLAYLIST_URL=

# URL do Guia EPG XMLTV (Opcional - pode ser configurada pelo Painel ADM)
EPG_URL=

# Ambiente de execução (development ou production)
NODE_ENV=production
